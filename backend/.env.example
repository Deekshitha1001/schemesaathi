# Copy to .env and edit. Every variable is optional: the app runs with none of them set.

# --- LLM (optional). Without it the app uses the rule-based extractor and shows retrieved passages as answers.
LLM_PROVIDER=none                 # none | anthropic
# ANTHROPIC_API_KEY=sk-ant-...    # never commit this
ANTHROPIC_MODEL=claude-haiku-5-5  # a small, cheap model is enough for extraction and short answers

# --- Retrieval
EMBEDDING_BACKEND=tfidf           # tfidf (offline) | sentence-transformers (needs the package + a model download)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# MIN_RELEVANT_SCORE=0.10         # raise to be stricter about what counts as a match; re-run eval/eval_retrieval.py after changing

# --- Speech-to-text (optional, server side). The browser's own speech recognition is the default.
WHISPER_ENABLED=true              # only used if faster-whisper is installed
WHISPER_MODEL=small

# --- Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
RATE_LIMIT_PER_MINUTE=30          # per client IP; 0 disables
MAX_TEXT_CHARS=2000
MAX_AUDIO_MB=10
TRUST_PROXY=false                 # true ONLY behind your own reverse proxy that sets X-Forwarded-For
# SERVE_FRONTEND_DIR=../frontend/dist   # serve the built UI from the API process (single-container deploys)
